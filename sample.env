# ========================================================================
#   YUKI YT API - Environment Configuration Template
# ========================================================================

# Server Network Settings
PORT=8000
HOST=0.0.0.0
WORKERS=2
RELOAD=false

# Media Caching & Retention
CACHE_DIR=YUKIYTAPI/saved
MAX_CACHE_SIZE_MB=5000
TOKEN_EXPIRY_SECONDS=60

# Rate Limiting & Security (Optional)
RATE_LIMIT_PER_MINUTE=60
API_SECRET_KEY=

# YouTube Cookies Path (Optional, defaults to root cookies.txt)
COOKIES_FILE=cookies.txt
